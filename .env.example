# Copy to .env.local (gitignored) and fill in. Never commit real values.
# NEXT_PUBLIC_* values are visible in the browser — public keys only.

# Supabase → Project Settings → API Keys (Step B)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# TomTom Traffic API — server-only. Put the actual value in .env.local.
# Obtain a key at https://my.tomtom.com/ → API & SDK Keys.
TOMTOM_TRAFFIC_API_KEY=

# Server-side secrets do NOT go here — set them with `supabase secrets set NAME=value`
# (e.g. GEMINI_API_KEY, only if the optional planning copilot is built).
