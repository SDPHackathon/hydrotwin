# Copy to .env.local (gitignored) and fill in. Never commit real values.
# NEXT_PUBLIC_* values are visible in the browser — public keys only.

# Supabase → Project Settings → API Keys (Step B)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only — the Next.js API routes write to Supabase with it (Secret key / service_role).
# Never prefix it with NEXT_PUBLIC_ and never commit a value. Without it, cloud writes fail
# once 20261018234500_lock_public_writes.sql is applied (Local Sim still works).
SUPABASE_SERVICE_ROLE_KEY=

# TomTom Traffic API — server-only. Put the actual value in .env.local.
# Obtain a key at https://my.tomtom.com/ → API & SDK Keys.
TOMTOM_TRAFFIC_API_KEY=

# Edge Function secrets do NOT go here — set them with `supabase secrets set NAME=value`
# (e.g. GEMINI_API_KEY, only if the optional planning copilot is built).
